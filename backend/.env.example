# Application Configuration
APP_NAME=THERMOS AI
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Server Configuration
HOST=0.0.0.0
PORT=8000
RELOAD=true

# Database Configuration
DATABASE_URL=postgresql+psycopg://thermos_user:thermos_password@localhost:5432/thermos_db
DATABASE_ECHO=false

# PostgreSQL/PostGIS Connection Details
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=thermos_db
POSTGRES_USER=thermos_user
POSTGRES_PASSWORD=thermos_password

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# Security
SECRET_KEY=your-secret-key-change-this-in-production-min-32-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Data Storage Paths
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
DATA_SAMPLE_DIR=./data/sample
ML_MODELS_DIR=./ml/saved_models
UPLOAD_DIR=./data/uploads

# Geographic Configuration
DEFAULT_SRID=4326
PROJECTED_SRID=32643
PILOT_REGION=Panvel and Navi Mumbai

# External Data Sources (Optional - configure when available)
# Google Earth Engine
# GEE_SERVICE_ACCOUNT=
# GEE_PRIVATE_KEY_PATH=

# Sentinel Hub (for Sentinel-5P)
# SENTINEL_HUB_CLIENT_ID=
# SENTINEL_HUB_CLIENT_SECRET=

# NASA EarthData
# EARTHDATA_USERNAME=
# EARTHDATA_PASSWORD=

# Application Features
ENABLE_DEMO_MODE=true
ENABLE_ML_PREDICTIONS=true
ENABLE_SYNTHETIC_DATA=true

# ML Configuration
ML_RANDOM_STATE=42
ML_TEST_SIZE=0.2
ML_CV_FOLDS=5

# Validation and Limits
MAX_REQUEST_SIZE_MB=50
MAX_UPLOAD_SIZE_MB=100
PAGINATION_DEFAULT_LIMIT=50
PAGINATION_MAX_LIMIT=1000
SPATIAL_QUERY_MAX_FEATURES=10000

# Logging
LOG_FILE_PATH=./logs/thermos.log
LOG_ROTATION_SIZE_MB=100
LOG_RETENTION_DAYS=30

# Cache Configuration (Future)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Monitoring (Future)
# SENTRY_DSN=
